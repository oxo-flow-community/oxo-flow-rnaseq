# oxo-flow port of nf-core/rnaseq 3.26.0 (default-parameters main path).
#
# Upstream: https://github.com/nf-core/rnaseq @ 3.26.0
#   (sha e7ca46272c8f9d5ceee3f71759f4ba551d3217a4)
# Default path: FastQC -> TrimGalore -> fq lint -> STAR align -> Picard mark
#   duplicates -> Salmon quant (alignment mode) -> tximport merged counts +
#   SummarizedExperiment RDS -> StringTie assembly/quant -> featureCounts gene
#   counts -> RSeQC + dupRadar + Qualimap QC -> DESeq2 QC -> bigWig tracks
#   -> MultiQC (44 rules).
#
# Fidelity notes:
# - Commands mirror the upstream modules byte-for-byte under default params
#   (the star_salmon aligner, trimgalore trimmer, no pseudo-alignment).
# - Upstream process labels (cpus/memory/time) are baked into [rules.resources].
# - Upstream per-sample strandedness (samplesheet column) is a pipeline-level
#   [config] setting here; 'auto' is not ported (default 'unstranded').
# - The workflow-level MultiQC custom content (fail_trimmed / fail_mapped /
#   strand checks / sample merge) is generated by scripts/multiqc_custom_content.py.
# - Read QC / alignment / BAM QC / bigWig rules live in modules/*.oxoflow and
#   are pulled in below via [[include]] namespaces.
#
# Not ported (see README fidelity table): the chain-wide per-sample
# min_trimmed_reads drop (the fastqc_filtered_* rules DO gate on it via
# reads_count). Ported in this wave: cat_fastq multi-pair
# read merging (fastq_qc::cat_reads via input_groups), per-sample strandedness
# (metadata_file 'strandedness' column with config fallback) and the
# PREPARE_GENOME reference chain (CUSTOM_GTFFILTER / gffread GFF->GTF /
# additional_fasta / GENCODE preprocessing). gene_bed / chrom_sizes /
# transcript_fasta are auto-built from fasta+gtf in modules/prepare_genome.oxoflow
# when the corresponding config key is empty (defaults point at the shipped fixtures).

[workflow]
name = "oxo-flow-rnaseq"
version = "1.0.0"
description = "RNA-seq analysis with STAR: FastQC, TrimGalore, STAR alignment, Picard mark duplicates, featureCounts / RSeQC / dupRadar / Qualimap QC and MultiQC — oxo-flow port of nf-core/rnaseq 3.26.0 (default star_salmon path)"
author = "oxo-flow-community"

[config]
# Output directory (upstream: --outdir).
out_dir = "results"
# Input reads directory: reads_dir/<sample>_R1.fastq.gz + _R2.fastq.gz
# (paired-end). The repo default ships the tiny committed fixtures; point
# this at your data.
reads_dir = "test/fixtures/raw"
# Reference artifacts (upstream: --fasta / --gtf / --gene_bed / --chrom_sizes
# / --transcript_fasta / STAR index). fasta and gtf are always inputs; the
# other three are inputs by default but are DERIVED from fasta+gtf when the
# key is empty (modules/prepare_genome.oxoflow mirrors upstream PREPARE_GENOME:
# gene_bed via ea-utils gtf2bed, chrom_sizes via samtools faidx, transcript_fasta
# via RSEM). The STAR index is an input (auto-built from the shipped fixture
# genome by the [[references]] builder below when SAindex is missing).
fasta = "test/fixtures/reference/genome.fa"
gtf = "test/fixtures/reference/genes.gtf"
gene_bed = "test/fixtures/reference/gene.bed"
chrom_sizes = "test/fixtures/reference/chrom_sizes.txt"
star_index = "test/fixtures/reference/star_index"
transcript_fasta = "test/fixtures/reference/transcripts.fa"
# PREPARE_GENOME reference chain (upstream subworkflows/local/prepare_genome):
# gtf / fasta may be gzipped (.gz); gff is converted to GTF with gffread;
# the GTF is filtered to genome sequences when skip_gtf_filter=false (the
# upstream gate: alignment or pseudo-alignment enabled, or no
# transcript_fasta); additional_fasta (optionally .gz) is concatenated onto
# the genome and its sequences appended to the GTF as transgenes with
# biotype featurecounts_group_type. Canonical artifacts under
# results/reference/ (gtf.processed.gtf, genome.fa) feed every downstream
# rule. Note: gtf_extra_attributes / gtf_group_features are tximport /
# featureCounts-only upstream -- they do not gate the filter.
gff = ""
additional_fasta = ""
skip_gtf_filter = false
skip_gtf_transcript_filter = false
# gencode: GENCODE reference genomes use gene_type as the group feature and
# preprocess a provided transcript_fasta by stripping '|'-joined identifiers
# (upstream PREPROCESS_TRANSCRIPTS_FASTA_GENCODE: cut -d "|" -f1).
gencode = false
# Library strandedness. Upstream reads this per-sample from the samplesheet
# ('auto' supported); the port falls back to this pipeline-level value. Three
# explicit values are supported; 'auto' behaves like the fallback (resolved
# per rule). For per-sample strandedness, add a metadata_file with a
# 'strandedness' column ('forward' / 'reverse' / 'unstranded' / 'auto' /
# empty): each rule resolves the metadata value first and falls back to this
# key when the column is missing, empty or 'auto'. Consumers: featureCounts
# (-s), Qualimap (-p), dupRadar, salmon/kallisto/RSEM/StringTie library-type,
# HISAT2 --rna-strandness and the forward/reverse bigWig gates.
strandedness = "unstranded"
# Aligner selector (upstream: --aligner). The port supports the upstream
# default 'star_salmon' plus the non-default branches (star_rsem, hisat2,
# bowtie2_salmon); all downstream results paths follow
# {config.out_dir}/{config.aligner}/... exactly like upstream's
# params.aligner-based publishDirs. bowtie2_salmon maps reads to the
# transcriptome with Bowtie2 and quantifies the orig_bam with Salmon
# (upstream ALIGN_BOWTIE2 -> QUANTIFY_BAM_SALMON).
aligner = "star_salmon"
# Thresholds (upstream params with the same defaults).
min_trimmed_reads = 10000
min_mapped_reads = 5
stranded_threshold = 0.8
unstranded_threshold = 0.1
# featureCounts settings (upstream params with the same defaults).
featurecounts_group_type = "gene_biotype"
featurecounts_feature_type = "exon"
# fq lint extra args (upstream: --extra_fqlint_args).
extra_fqlint_args = "--disable-validator P001"
# Skip options (upstream: --skip_fastqc / --skip_linting / --skip_trimming /
# --skip_markduplicates / --skip_qc / --skip_bigwig). Same defaults as
# upstream. NOTE: skip_trimming=true and skip_markduplicates=true break the
# downstream chain (trimmed reads / markdup BAM are inputs of later rules);
# unlike upstream there is no per-branch rewire, see README fidelity table.
skip_fastqc = false
skip_linting = false
skip_trimming = false
skip_markduplicates = false
skip_qc = false
skip_bigwig = false
# Publication controls (upstream: --save_trimmed / --save_align_intermeds).
# The port keeps trimmed FASTQs and intermediate BAMs at results/ paths
# regardless (they double as checkpoints); these keys are accepted for
# upstream parity and reserved for future use.
save_trimmed = false
save_align_intermeds = false
# CAT_FASTQ merged reads (upstream --save_merged_fastq): the merged FASTQs
# are always kept at results/read_merging/ (they double as checkpoints); the
# key is accepted for upstream parity, like save_trimmed.
save_merged_fastq = false
# Salmon quantification (upstream default path, alignment mode on the STAR
# toTranscriptome BAM). --libType is derived from config.strandedness
# (forward -> ISF, reverse -> ISR, unstranded -> IU); set
# salmon_quant_libtype to override (e.g. "A" for auto-detection).
salmon_quant_libtype = ""
# StringTie reference-guided assembly/quantification (-G gtf, -e, ballgown).
skip_stringtie = false
# Cross-sample tximport merge + SummarizedExperiment RDS objects.
skip_quantification_merge = false
# DESeq2 sample-level QC (PCA / sample distances / size factors; upstream
# default path, runs on salmon.merged.gene_counts_length_scaled.tsv).
skip_deseq2_qc = false
# DESeq2 QC transform: variance stabilizing transformation (upstream
# --deseq2_vst default true).
deseq2_vst = true
# UMI handling (upstream: --with_umi / --skip_umi_extract / --umi_dedup_tool /
# --umitools_* / --umi_discard_read / --save_umi_intermeds; same defaults).
with_umi = false
skip_umi_extract = false
umi_dedup_tool = "umitools"
umitools_grouping_method = "directional"
umitools_dedup_stats = false
umitools_dedup_primary_only = false
# Empty = no --umi-separator flag (upstream default null).
umitools_umi_separator = ""
umi_discard_read = 0
save_umi_intermeds = false
# BBSplit genome filtering (upstream: --skip_bbsplit / --bbsplit_fasta_list /
# --save_bbsplit_reads; same defaults). bbsplit_fasta_list is a 2-column CSV
# (short_name,path_to_fasta) plus the primary genome in config.fasta.
skip_bbsplit = true
bbsplit_fasta_list = ""
save_bbsplit_reads = false
# Ribosomal RNA removal (upstream: --remove_ribo_rna / --ribo_removal_tool /
# --ribo_database_manifest / --save_non_ribo_reads; same defaults). The
# manifest is one fasta path per line; .gz entries are gunzipped before use.
remove_ribo_rna = false
ribo_removal_tool = "sortmerna"
ribo_database_manifest = "assets/rrna-db-defaults.txt"
save_non_ribo_reads = false
# Non-default alignment branches (upstream: --aligner / --skip_alignment /
# --rsem_index / --hisat2_index / --salmon_index / --bbsplit_index /
# --sortmerna_index). Empty index keys are auto-built by when-gated builder
# rules in modules/alignment.oxoflow / quantification.oxoflow from the
# shipped fixtures when the branch is enabled (like star_index); a
# user-supplied path is untarred (.tar.gz/.tgz/.tar archives, like upstream
# UNTAR_*_INDEX) or symlinked (directories) in instead.
skip_alignment = false
rsem_index = ""
hisat2_index = ""
bowtie2_index = ""
salmon_index = ""
bbsplit_index = ""
sortmerna_index = ""
# Pseudo-alignment (upstream: --pseudo_aligner, 'salmon' or 'kallisto';
# default null = alignment-mode Salmon only). Both aligners are ported; the
# index builders are when-gated on this key (salmon_index / kallisto_index
# short-circuit with a user-supplied path). pseudo_aligner_kmer_size is the
# upstream KALLISTO_INDEX -k default (31).
pseudo_aligner = ""
skip_pseudo_alignment = false
kallisto_index = ""
pseudo_aligner_kmer_size = 31
# tximport gene attributes (upstream: --gtf_group_features /
# --gtf_extra_attributes; same defaults).
gtf_group_features = "gene_id"
gtf_extra_attributes = "gene_name"

[defaults]
threads = 1
memory = "6G"

# Default sample cohort. In oxo-flow a workflow has exactly one sample source;
# the upstream samplesheet (id/fastq_1/fastq_2/strandedness) is represented by
# one [[sample_groups]] block of paired-end samples sharing the pipeline-level
# strandedness above. umi1_pattern mirrors the upstream samplesheet column and
# is consumed only by the with_umi branch (umitools_extract_umis).
[[sample_groups]]
name = "samples"
samples = ["S1", "S2"]
metadata = { umi1_pattern = "NNNNNN", umi2_pattern = "" }

# Auto-built reference: the STAR index is an upstream input artifact (the
# port ships no binary index), so the engine builds it from the shipped
# fixture genome when the sentinel is missing — a fresh clone runs end to
# end. An existing index (SAindex present) wins; for real data point
# config.star_index at your own index directory.
[[references]]
name = "star_index"
source = "test/fixtures/reference/genome.fa"
output = "test/fixtures/reference/star_index/SAindex"
build = "mkdir -p test/fixtures/reference/star_index && STAR --runMode genomeGenerate --genomeDir test/fixtures/reference/star_index --genomeFastaFiles {source} --sjdbGTFfile test/fixtures/reference/genes.gtf --runThreadN 8"
threads = 8
memory = "16G"

[references.environment]
conda = "envs/star.yaml"


[[include]]
path = "modules/fastq_qc.oxoflow"
namespace = "fastq_qc"

[[include]]
path = "modules/prepare_genome.oxoflow"
namespace = "prepare_genome"

[[include]]
path = "modules/alignment.oxoflow"
namespace = "alignment"

[[include]]
path = "modules/bam_qc.oxoflow"
namespace = "bam_qc"

[[include]]
path = "modules/bigwig.oxoflow"
namespace = "bigwig"

[[include]]
path = "modules/quantification.oxoflow"
namespace = "quantification"

# ---------------------------------------------------------------------------
# Workflow-level MultiQC custom content (subworkflows/local/multiqc_rnaseq).
# One rule generates: fail_trimmed_samples_mqc.tsv, fail_mapped_samples_mqc.tsv,
# strand_check_summary_mqc.json + strand_check_composition_mqc.json,
# name_replacement.txt, multiqc_sample_merge.yml,
# nf_core_rnaseq_software_mqc_versions.yml, workflow_summary_mqc.yaml and
# methods_description_mqc.yaml.
# ---------------------------------------------------------------------------

[[rules]]
name = "multiqc_custom_content"
description = "Generate nf-core/rnaseq MultiQC custom content (fail_trimmed / fail_mapped tables, strand check JSONs, name replacement, sample-merge config, software versions)"
input = ["assets/multiqc/multiqc_config.yml", "assets/multiqc/sample_status_header.txt", "assets/multiqc/strand_check_summary.yaml", "assets/multiqc/strand_check_composition.yaml"]
expand_inputs = [
    # NOTE: patterns keep a literal {config.out_dir} prefix (no out_dir
    # variable): DAG edges are exact-string matches, and {config.out_dir}
    # resolves at render time. A concrete "results/..." prefix would not match
    # producer outputs that still contain the literal {config.out_dir} wildcard.
    { pattern = "{config.out_dir}/trimgalore/{sample}_trimmed_1.fastq.gz_trimming_report.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/log/{sample}.Log.final.out", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/log/{sample}.bowtie2.log", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/rseqc/infer_experiment/{sample}.infer_experiment.txt", variables = { sample = "config.samples_list" } },
]
output = [
    "{config.out_dir}/multiqc/fail_trimmed_samples_mqc.tsv",
    "{config.out_dir}/multiqc/fail_mapped_samples_mqc.tsv",
    "{config.out_dir}/multiqc/strand_check_summary_mqc.json",
    "{config.out_dir}/multiqc/strand_check_composition_mqc.json",
    "{config.out_dir}/multiqc/name_replacement.txt",
    "{config.out_dir}/multiqc/multiqc_sample_merge.yml",
    "{config.out_dir}/multiqc/nf_core_rnaseq_software_mqc_versions.yml",
    "{config.out_dir}/multiqc/workflow_summary_mqc.yaml",
    "{config.out_dir}/multiqc/methods_description_mqc.yaml",
]
shell = """
ENGINE_VERSION="$(oxo-flow --version | sed 's/^oxo-flow //')"
python scripts/multiqc_custom_content.py \\
    --out-dir {config.out_dir}/multiqc \\
    --aligner {config.aligner} \\
    --samples {config.samples_list} \\
    --reads-dir {config.reads_dir} \\
    --strandedness {config.strandedness} \\
    --min-trimmed-reads {config.min_trimmed_reads} \\
    --min-mapped-reads {config.min_mapped_reads} \\
    --stranded-threshold {config.stranded_threshold} \\
    --unstranded-threshold {config.unstranded_threshold} \\
    --status-header assets/multiqc/sample_status_header.txt \\
    --summary-asset assets/multiqc/strand_check_summary.yaml \\
    --composition-asset assets/multiqc/strand_check_composition.yaml \\
    --engine-version "$ENGINE_VERSION" \\
    --engine-command "oxo-flow run main.oxoflow" \\
    --config aligner={config.aligner} \\
    --config reads_dir={config.reads_dir} \\
    --config out_dir={config.out_dir} \\
    --config strandedness={config.strandedness} \\
    --config min_trimmed_reads={config.min_trimmed_reads} \\
    --config min_mapped_reads={config.min_mapped_reads} \\
    --config stranded_threshold={config.stranded_threshold} \\
    --config unstranded_threshold={config.unstranded_threshold}
"""
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/multiqc.yaml"

# ---------------------------------------------------------------------------
# MultiQC report (merged mode; nf-core MULTIQC with the rnaseq asset config,
# sample-merge config and --replace-names).
# ---------------------------------------------------------------------------

[[rules]]
name = "multiqc"
description = "MultiQC report (nf-core MULTIQC merged mode, results/multiqc/{config.aligner})"
input = [
    "{config.out_dir}/multiqc/fail_trimmed_samples_mqc.tsv",
    "{config.out_dir}/multiqc/fail_mapped_samples_mqc.tsv",
    "{config.out_dir}/multiqc/strand_check_summary_mqc.json",
    "{config.out_dir}/multiqc/strand_check_composition_mqc.json",
    "{config.out_dir}/multiqc/name_replacement.txt",
    "{config.out_dir}/multiqc/multiqc_sample_merge.yml",
    "{config.out_dir}/multiqc/nf_core_rnaseq_software_mqc_versions.yml",
    "{config.out_dir}/multiqc/workflow_summary_mqc.yaml",
    "{config.out_dir}/multiqc/methods_description_mqc.yaml",
    "{config.out_dir}/{config.aligner}/deseq2_qc/{config.aligner}.pca.vals_mqc.tsv",
    "{config.out_dir}/{config.aligner}/deseq2_qc/{config.aligner}.sample.dists_mqc.tsv",
    "{config.out_dir}/{config.pseudo_aligner}/deseq2_qc/{config.pseudo_aligner}.pca.vals_mqc.tsv",
    "{config.out_dir}/{config.pseudo_aligner}/deseq2_qc/{config.pseudo_aligner}.sample.dists_mqc.tsv",
    "assets/multiqc/multiqc_config.yml",
]
expand_inputs = [
    # FastQC raw + trimmed (html + zip), trimgalore reports, STAR logs,
    # salmon quant.sf (alignment + pseudo modes, staged into <id>/ subdirs),
    # samtools stats/flagstat/idxstats for sorted, markdup and UMI-deduped
    # BAMs, picard metrics, featureCounts summary + biotype tables, RSeQC
    # outputs, dupRadar MultiQC tables, Qualimap results (staged into <id>/
    # subdirs), UMI-tools genome-side dedup logs, RSEM per-sample .stat
    # files. The patterns mirror the upstream MultiQC channels exactly:
    # transcriptome-side dedup stats, the umitools per-UMI TSVs and the
    # prepare-for-rsem logs are emitted by the UMI subworkflow but never
    # mixed into its multiqc_files channel, so they stay out of the report.
    # NOTE: patterns keep a literal {config.out_dir} prefix (no out_dir
    # variable): DAG edges are exact-string matches, and {config.out_dir}
    # resolves at render time. A concrete "results/..." prefix would not match
    # producer outputs that still contain the literal {config.out_dir} wildcard.
    # fq lint tables (raw + trimmed) — upstream nf-core stages both into
    # MultiQC; without these patterns the lint rules look disconnected in
    # the workflow graph and their tables never reach the report.
    { pattern = "{config.out_dir}/fq_lint/raw/{sample}.fq_lint.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fq_lint/trimmed/{sample}.fq_lint.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/raw/{sample}_raw_1_fastqc.html", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/raw/{sample}_raw_1_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/raw/{sample}_raw_2_fastqc.html", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/raw/{sample}_raw_2_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/trim/{sample}_trimmed_1_val_1_fastqc.html", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/trim/{sample}_trimmed_1_val_1_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/trim/{sample}_trimmed_2_val_2_fastqc.html", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/trim/{sample}_trimmed_2_val_2_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/trimgalore/{sample}_trimmed_1.fastq.gz_trimming_report.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/trimgalore/{sample}_trimmed_2.fastq.gz_trimming_report.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/log/{sample}.Log.final.out", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/log/{sample}.bowtie2.log", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/{sample}/quant.sf", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/samtools_stats/{sample}.sorted.bam.stats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/samtools_stats/{sample}.sorted.bam.flagstat", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/samtools_stats/{sample}.sorted.bam.idxstats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/samtools_stats/{sample}.markdup.sorted.bam.stats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/samtools_stats/{sample}.markdup.sorted.bam.flagstat", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/samtools_stats/{sample}.markdup.sorted.bam.idxstats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/picard_metrics/{sample}.markdup.sorted.metrics.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/featurecounts/{sample}.featureCounts.tsv.summary", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/featurecounts/{sample}.biotype_counts_mqc.tsv", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/featurecounts/{sample}.biotype_counts_rrna_mqc.tsv", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/rseqc/bam_stat/{sample}.bam_stat.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/rseqc/infer_experiment/{sample}.infer_experiment.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/rseqc/inner_distance/txt/{sample}.inner_distance_freq.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/rseqc/junction_annotation/log/{sample}.junction_annotation.log", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/rseqc/junction_saturation/rscript/{sample}.junctionSaturation_plot.r", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/rseqc/read_distribution/{sample}.read_distribution.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/rseqc/read_duplication/xls/{sample}.pos.DupRate.xls", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/dupradar/multiqc/{sample}_dup_intercept_mqc.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/dupradar/multiqc/{sample}_duprateExpDensCurve_mqc.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/qualimap/{sample}/rnaseq_qc_results.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/umitools/genomic_dedup_log/{sample}.umi_dedup.sorted.log", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/samtools_stats/{sample}.umi_dedup.sorted.bam.stats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/samtools_stats/{sample}.umi_dedup.sorted.bam.flagstat", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/samtools_stats/{sample}.umi_dedup.sorted.bam.idxstats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.aligner}/{sample}.stat", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.pseudo_aligner}/{sample}/quant.sf", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/{config.pseudo_aligner}/{sample}/kallisto_quant.log", variables = { sample = "config.samples_list" } },
]
output = [
    "{config.out_dir}/multiqc/{config.aligner}/multiqc_report.html",
]
shell = """
# Stage every contributor into one flat directory so the merged MultiQC run
# sees exactly what the upstream merged mode hands to MultiQC. Qualimap
# results keep their <id>/ subdirectory so MultiQC names the samples <id>.
rm -rf mqc_stage
mkdir -p mqc_stage
for f in {input}; do
    case "$f" in
        */rnaseq_qc_results.txt)
            d="mqc_stage/$(basename "$(dirname "$f")")"
            mkdir -p "$d"
            cp -L "$f" "$d/"
            ;;
        */quant.sf)
            # salmon quant dirs stage into <sample>/quant.sf so the merged
            # MultiQC run picks them up per-sample (upstream merged mode).
            d="mqc_stage/$(basename "$(dirname "$f")")"
            mkdir -p "$d"
            cp -L "$f" "$d/"
            ;;
        */kallisto_quant.log)
            # Kallisto logs carry no per-sample filename (upstream publishes
            # them unrenamed from the work dir), so rename on stage to
            # <sample>.kallisto_quant.log. The MultiQC kallisto module matches
            # by content ("[quant] finding pseudoalignments for the reads"),
            # so the rename is safe.
            cp -L "$f" "mqc_stage/$(basename "$(dirname "$f")").kallisto_quant.log"
            ;;
        *) cp -L "$f" mqc_stage/ ;;
    esac
done
cd mqc_stage
multiqc --force --config multiqc_config.yml --config multiqc_sample_merge.yml --filename multiqc_report.html --replace-names name_replacement.txt .
# The aligner subdir only exists when an earlier aligner-scoped rule
# (e.g. deseq2_qc) created it; hisat2/star_rsem have no such rule, so
# mkdir -p before the move (live: hisat2 multiqc lost the report).
mkdir -p ../{config.out_dir}/multiqc/{config.aligner}
mv multiqc_report.html ../{config.out_dir}/multiqc/{config.aligner}/multiqc_report.html
cd ..
rm -rf mqc_stage
"""
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/multiqc.yaml"
