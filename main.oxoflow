# oxo-flow port of nf-core/rnaseq 3.26.0 (default-parameters main path).
#
# Upstream: https://github.com/nf-core/rnaseq @ 3.26.0
#   (sha e7ca46272c8f9d5ceee3f71759f4ba551d3217a4)
# Default path: FastQC -> TrimGalore -> fq lint -> STAR align -> Picard mark
#   duplicates -> Salmon quant (alignment mode) -> tximport merged counts +
#   SummarizedExperiment RDS -> StringTie assembly/quant -> featureCounts gene
#   counts -> RSeQC + dupRadar + Qualimap QC -> DESeq2 QC -> bigWig tracks
#   -> MultiQC (44 rules).
#
# Fidelity notes:
# - Commands mirror the upstream modules byte-for-byte under default params
#   (the star_salmon aligner, trimgalore trimmer, no pseudo-alignment).
# - Upstream process labels (cpus/memory/time) are baked into [rules.resources].
# - Upstream per-sample strandedness (samplesheet column) is a pipeline-level
#   [config] setting here; 'auto' is not ported (default 'unstranded').
# - The workflow-level MultiQC custom content (fail_trimmed / fail_mapped /
#   strand checks / sample merge) is generated by scripts/multiqc_custom_content.py.
# - Read QC / alignment / BAM QC / bigWig rules live in modules/*.oxoflow and
#   are pulled in below via [[include]] namespaces.
#
# Not ported (see README fidelity table): rsem / hisat2 / umicollapse
# quantification, as_quantification, PREPARE_GENOME (reference artifacts are
# inputs), per-sample min_trimmed_reads filtering, UMI extraction, BBSplit /
# rRNA removal, and the Nextflow-param-rendered workflow_summary /
# methods_description MultiQC sections.

[workflow]
name = "oxo-flow-rnaseq"
version = "1.0.0"
description = "RNA-seq analysis with STAR: FastQC, TrimGalore, STAR alignment, Picard mark duplicates, featureCounts / RSeQC / dupRadar / Qualimap QC and MultiQC — oxo-flow port of nf-core/rnaseq 3.26.0 (default star_salmon path)"
author = "oxo-flow-community"

[config]
# Output directory (upstream: --outdir).
out_dir = "results"
# Input reads directory: reads_dir/<sample>_R1.fastq.gz + _R2.fastq.gz
# (paired-end). The repo default ships the tiny committed fixtures; point
# this at your data.
reads_dir = "test/fixtures/raw"
# Reference artifacts (upstream: --fasta / --gtf / --gene_bed / --chrom_sizes
# / --transcript_fasta / STAR index). PREPARE_GENOME is not ported: the STAR
# index is an input. transcript_fasta feeds Salmon alignment-mode quant and
# StringTie.
fasta = "test/fixtures/reference/genome.fa"
gtf = "test/fixtures/reference/genes.gtf"
gene_bed = "test/fixtures/reference/gene.bed"
chrom_sizes = "test/fixtures/reference/chrom_sizes.txt"
star_index = "test/fixtures/reference/star_index"
transcript_fasta = "test/fixtures/reference/transcripts.fa"
# Library strandedness. Upstream reads this per-sample from the samplesheet
# ('auto' supported); the port is pipeline-level and supports the three
# explicit values only. Used by featureCounts (-s), Qualimap (-p), dupRadar
# and the forward/reverse bigWig gates.
strandedness = "unstranded"
# Aligner: only the upstream default 'star_salmon' path is ported.
aligner = "star_salmon"
# Thresholds (upstream params with the same defaults).
min_trimmed_reads = 10000
min_mapped_reads = 5
stranded_threshold = 0.8
unstranded_threshold = 0.1
# featureCounts settings (upstream params with the same defaults).
featurecounts_group_type = "gene_biotype"
featurecounts_feature_type = "exon"
# fq lint extra args (upstream: --extra_fqlint_args).
extra_fqlint_args = "--disable-validator P001"
# Skip options (upstream: --skip_fastqc / --skip_linting / --skip_trimming /
# --skip_markduplicates / --skip_qc / --skip_bigwig). Same defaults as
# upstream. NOTE: skip_trimming=true and skip_markduplicates=true break the
# downstream chain (trimmed reads / markdup BAM are inputs of later rules);
# unlike upstream there is no per-branch rewire, see README fidelity table.
skip_fastqc = false
skip_linting = false
skip_trimming = false
skip_markduplicates = false
skip_qc = false
skip_bigwig = false
# Publication controls (upstream: --save_trimmed / --save_align_intermeds).
# The port keeps trimmed FASTQs and intermediate BAMs at results/ paths
# regardless (they double as checkpoints); these keys are accepted for
# upstream parity and reserved for future use.
save_trimmed = false
save_align_intermeds = false
# Salmon quantification (upstream default path, alignment mode on the STAR
# toTranscriptome BAM). --libType is derived from config.strandedness
# (forward -> ISF, reverse -> ISR, unstranded -> IU); set
# salmon_quant_libtype to override (e.g. "A" for auto-detection).
salmon_quant_libtype = ""
# StringTie reference-guided assembly/quantification (-G gtf, -e, ballgown).
skip_stringtie = false
# Cross-sample tximport merge + SummarizedExperiment RDS objects.
skip_quantification_merge = false
# DESeq2 sample-level QC (PCA / sample distances / size factors; upstream
# default path, runs on salmon.merged.gene_counts_length_scaled.tsv).
skip_deseq2_qc = false
# DESeq2 QC transform: variance stabilizing transformation (upstream
# --deseq2_vst default true).
deseq2_vst = true

[defaults]
threads = 1
memory = "6G"

# Default sample cohort. In oxo-flow a workflow has exactly one sample source;
# the upstream samplesheet (id/fastq_1/fastq_2/strandedness) is represented by
# one [[sample_groups]] block of paired-end samples sharing the pipeline-level
# strandedness above.
[[sample_groups]]
name = "samples"
samples = ["S1", "S2"]

# Auto-built reference: the STAR index is an upstream input artifact (the
# port ships no binary index), so the engine builds it from the shipped
# fixture genome when the sentinel is missing — a fresh clone runs end to
# end. An existing index (SAindex present) wins; for real data point
# config.star_index at your own index directory.
[[references]]
name = "star_index"
source = "test/fixtures/reference/genome.fa"
output = "test/fixtures/reference/star_index/SAindex"
build = "mkdir -p test/fixtures/reference/star_index && STAR --runMode genomeGenerate --genomeDir test/fixtures/reference/star_index --genomeFastaFiles {source} --sjdbGTFfile test/fixtures/reference/genes.gtf --runThreadN 8"
threads = 8
memory = "16G"

[references.environment]
conda = "envs/star.yaml"


[[include]]
path = "modules/fastq_qc.oxoflow"
namespace = "fastq_qc"

[[include]]
path = "modules/alignment.oxoflow"
namespace = "alignment"

[[include]]
path = "modules/bam_qc.oxoflow"
namespace = "bam_qc"

[[include]]
path = "modules/bigwig.oxoflow"
namespace = "bigwig"

[[include]]
path = "modules/quantification.oxoflow"
namespace = "quantification"

# ---------------------------------------------------------------------------
# Workflow-level MultiQC custom content (subworkflows/local/multiqc_rnaseq).
# One rule generates: fail_trimmed_samples_mqc.tsv, fail_mapped_samples_mqc.tsv,
# strand_check_summary_mqc.json + strand_check_composition_mqc.json,
# name_replacement.txt, multiqc_sample_merge.yml and
# nf_core_rnaseq_software_mqc_versions.yml.
# ---------------------------------------------------------------------------

[[rules]]
name = "multiqc_custom_content"
description = "Generate nf-core/rnaseq MultiQC custom content (fail_trimmed / fail_mapped tables, strand check JSONs, name replacement, sample-merge config, software versions)"
input = ["assets/multiqc/multiqc_config.yml", "assets/multiqc/sample_status_header.txt", "assets/multiqc/strand_check_summary.yaml", "assets/multiqc/strand_check_composition.yaml"]
expand_inputs = [
    # NOTE: patterns keep a literal {config.out_dir} prefix (no out_dir
    # variable): DAG edges are exact-string matches, and {config.out_dir}
    # resolves at render time. A concrete "results/..." prefix would not match
    # producer outputs that still contain the literal {config.out_dir} wildcard.
    { pattern = "{config.out_dir}/trimgalore/{sample}_trimmed_1.fastq.gz_trimming_report.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/log/{sample}.Log.final.out", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/rseqc/infer_experiment/{sample}.infer_experiment.txt", variables = { sample = "config.samples_list" } },
]
output = [
    "{config.out_dir}/multiqc/fail_trimmed_samples_mqc.tsv",
    "{config.out_dir}/multiqc/fail_mapped_samples_mqc.tsv",
    "{config.out_dir}/multiqc/strand_check_summary_mqc.json",
    "{config.out_dir}/multiqc/strand_check_composition_mqc.json",
    "{config.out_dir}/multiqc/name_replacement.txt",
    "{config.out_dir}/multiqc/multiqc_sample_merge.yml",
    "{config.out_dir}/multiqc/nf_core_rnaseq_software_mqc_versions.yml",
]
shell = """
python scripts/multiqc_custom_content.py \\
    --out-dir {config.out_dir}/multiqc \\
    --samples {config.samples_list} \\
    --reads-dir {config.reads_dir} \\
    --strandedness {config.strandedness} \\
    --min-trimmed-reads {config.min_trimmed_reads} \\
    --min-mapped-reads {config.min_mapped_reads} \\
    --stranded-threshold {config.stranded_threshold} \\
    --unstranded-threshold {config.unstranded_threshold} \\
    --status-header assets/multiqc/sample_status_header.txt \\
    --summary-asset assets/multiqc/strand_check_summary.yaml \\
    --composition-asset assets/multiqc/strand_check_composition.yaml
"""
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/multiqc.yaml"

# ---------------------------------------------------------------------------
# MultiQC report (merged mode; nf-core MULTIQC with the rnaseq asset config,
# sample-merge config and --replace-names).
# ---------------------------------------------------------------------------

[[rules]]
name = "multiqc"
description = "MultiQC report (nf-core MULTIQC merged mode, results/multiqc/star_salmon)"
input = [
    "{config.out_dir}/multiqc/fail_trimmed_samples_mqc.tsv",
    "{config.out_dir}/multiqc/fail_mapped_samples_mqc.tsv",
    "{config.out_dir}/multiqc/strand_check_summary_mqc.json",
    "{config.out_dir}/multiqc/strand_check_composition_mqc.json",
    "{config.out_dir}/multiqc/name_replacement.txt",
    "{config.out_dir}/multiqc/multiqc_sample_merge.yml",
    "{config.out_dir}/multiqc/nf_core_rnaseq_software_mqc_versions.yml",
    "{config.out_dir}/star_salmon/deseq2_qc/star_salmon.pca.vals_mqc.tsv",
    "{config.out_dir}/star_salmon/deseq2_qc/star_salmon.sample.dists_mqc.tsv",
    "assets/multiqc/multiqc_config.yml",
]
expand_inputs = [
    # FastQC raw + trimmed (html + zip), trimgalore reports, STAR logs,
    # salmon quant.sf, samtools stats/flagstat/idxstats for sorted and
    # markdup BAMs, picard metrics, featureCounts summary + biotype tables,
    # RSeQC outputs, dupRadar MultiQC tables, Qualimap results (staged into
    # <id>/ subdirs).
    # NOTE: patterns keep a literal {config.out_dir} prefix (no out_dir
    # variable): DAG edges are exact-string matches, and {config.out_dir}
    # resolves at render time. A concrete "results/..." prefix would not match
    # producer outputs that still contain the literal {config.out_dir} wildcard.
    # fq lint tables (raw + trimmed) — upstream nf-core stages both into
    # MultiQC; without these patterns the lint rules look disconnected in
    # the workflow graph and their tables never reach the report.
    { pattern = "{config.out_dir}/fq_lint/raw/{sample}.fq_lint.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fq_lint/trimmed/{sample}.fq_lint.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/raw/{sample}_raw_1_fastqc.html", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/raw/{sample}_raw_1_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/raw/{sample}_raw_2_fastqc.html", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/raw/{sample}_raw_2_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/trim/{sample}_trimmed_1_val_1_fastqc.html", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/trim/{sample}_trimmed_1_val_1_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/trim/{sample}_trimmed_2_val_2_fastqc.html", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/trim/{sample}_trimmed_2_val_2_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/trimgalore/{sample}_trimmed_1.fastq.gz_trimming_report.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/trimgalore/{sample}_trimmed_2.fastq.gz_trimming_report.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/log/{sample}.Log.final.out", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/{sample}/quant.sf", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/samtools_stats/{sample}.sorted.bam.stats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/samtools_stats/{sample}.sorted.bam.flagstat", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/samtools_stats/{sample}.sorted.bam.idxstats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/samtools_stats/{sample}.markdup.sorted.bam.stats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/samtools_stats/{sample}.markdup.sorted.bam.flagstat", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/samtools_stats/{sample}.markdup.sorted.bam.idxstats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/picard_metrics/{sample}.markdup.sorted.metrics.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/featurecounts/{sample}.featureCounts.tsv.summary", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/featurecounts/{sample}.biotype_counts_mqc.tsv", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/featurecounts/{sample}.biotype_counts_rrna_mqc.tsv", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/rseqc/bam_stat/{sample}.bam_stat.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/rseqc/infer_experiment/{sample}.infer_experiment.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/rseqc/inner_distance/txt/{sample}.inner_distance_freq.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/rseqc/junction_annotation/log/{sample}.junction_annotation.log", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/rseqc/junction_saturation/rscript/{sample}.junctionSaturation_plot.r", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/rseqc/read_distribution/{sample}.read_distribution.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/rseqc/read_duplication/xls/{sample}.pos.DupRate.xls", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/dupradar/multiqc/{sample}_dup_intercept_mqc.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/dupradar/multiqc/{sample}_duprateExpDensCurve_mqc.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/star_salmon/qualimap/{sample}/rnaseq_qc_results.txt", variables = { sample = "config.samples_list" } },
]
output = [
    "{config.out_dir}/multiqc/star_salmon/multiqc_report.html",
]
shell = """
# Stage every contributor into one flat directory so the merged MultiQC run
# sees exactly what the upstream merged mode hands to MultiQC. Qualimap
# results keep their <id>/ subdirectory so MultiQC names the samples <id>.
rm -rf mqc_stage
mkdir -p mqc_stage
for f in {input}; do
    case "$f" in
        */rnaseq_qc_results.txt)
            d="mqc_stage/$(basename "$(dirname "$f")")"
            mkdir -p "$d"
            cp -L "$f" "$d/"
            ;;
        */quant.sf)
            # salmon quant dirs stage into <sample>/quant.sf so the merged
            # MultiQC run picks them up per-sample (upstream merged mode).
            d="mqc_stage/$(basename "$(dirname "$f")")"
            mkdir -p "$d"
            cp -L "$f" "$d/"
            ;;
        *) cp -L "$f" mqc_stage/ ;;
    esac
done
cd mqc_stage
multiqc --force --config multiqc_config.yml --config multiqc_sample_merge.yml --filename multiqc_report.html --replace-names name_replacement.txt .
mv multiqc_report.html ../{config.out_dir}/multiqc/star_salmon/multiqc_report.html
cd ..
rm -rf mqc_stage
"""
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/multiqc.yaml"
