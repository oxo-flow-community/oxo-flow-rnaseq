when = "config.pseudo_aligner == 'salmon' && !config.skip_pseudo_alignment && !config.skip_qc && !config.skip_deseq2_qc && !config.skip_quantification_merge"
shell = """
VST_FLAG=""
if [ "{config.deseq2_vst}" = "true" ]; then
    VST_FLAG="--vst TRUE"
fi
Rscript scripts/deseq2_qc.r \\
    --count_file {input[0]} \\
    --outdir ./ \\
    --cores 6 \\
    --outprefix deseq2 \\
    --id_col 1 \\
    --sample_suffix '' \\
    --count_col 3 \\
    $VST_FLAG
if [ -f "R_sessionInfo.log" ]; then
    sed "s/deseq2_pca/{config.pseudo_aligner}_deseq2_pca/g" <{input[1]} > pca_header.tmp
    sed -i -e "s/DESeq2 PCA/SALMON DESeq2 PCA/g" pca_header.tmp
    cat pca_header.tmp *.pca.vals.txt > {config.pseudo_aligner}.pca.vals_mqc.tsv
    rm pca_header.tmp
    sed "s/deseq2_clustering/{config.pseudo_aligner}_deseq2_clustering/g" <{input[2]} > clustering_header.tmp
    sed -i -e "s/DESeq2 sample/SALMON DESeq2 sample/g" clustering_header.tmp
    cat clustering_header.tmp *.sample.dists.txt > {config.pseudo_aligner}.sample.dists_mqc.tsv
    rm clustering_header.tmp
fi
mkdir -p {config.out_dir}/{config.pseudo_aligner}/deseq2_qc
mv deseq2.dds.RData deseq2.pca.vals.txt deseq2.plots.pdf deseq2.sample.dists.txt \\
    {config.pseudo_aligner}.pca.vals_mqc.tsv {config.pseudo_aligner}.sample.dists_mqc.tsv R_sessionInfo.log \\
    {config.out_dir}/{config.pseudo_aligner}/deseq2_qc/
mv size_factors {config.out_dir}/{config.pseudo_aligner}/deseq2_qc/
"""
[rules.resources]
threads = 6
memory = "36G"
[rules.environment]
conda = "envs/deseq2.yaml"
