[workflow]
name = "prepare_genome"
description = "Reference derivations: gene BED (ea-utils gtf2bed), chrom.sizes (samtools faidx) and transcript FASTA (RSEM preparereference), with symlink short-circuits for user-supplied paths"

# ---------------------------------------------------------------------------
# PREPARE_GENOME derivations (upstream subworkflows/local/prepare_genome).
# When the corresponding config key is empty, the reference artifact is
# derived from the genome + GTF exactly like upstream; a user-supplied path
# is symlinked in instead (established index-builder pattern). Outputs land
# at canonical paths under {config.out_dir}/reference/ that downstream
# consumers reference. NOTE: the symlink target is resolved to an absolute
# path in-shell — {config.*} renders verbatim (a relative fixture path would
# otherwise produce a broken link, unlike {input[i]} which renders absolute).
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Reference chain (upstream subworkflows/local/prepare_genome): the shipped
# gtf / fasta may be gzipped (.gz); config.gff is converted to GTF with
# gffread; the GTF is filtered to genome sequences (CUSTOM_GTFFILTER) when
# the upstream gate holds and skip_gtf_filter=false; additional_fasta
# (optionally .gz) is concatenated onto the genome and its sequences
# appended to the GTF as transgenes with biotype featurecounts_group_type.
# Canonical artifacts consumed by every downstream rule:
#   results/reference/gtf.gtf -> gtf.filtered.gtf -> gtf.processed.gtf
#   results/reference/genome.fa
# The rules below use exclusive when-gates (repo pattern) so exactly one
# variant writes each canonical path. NOTE: the [[references]] STAR index
# builder in main.oxoflow keeps the raw fixture paths -- references build
# before the rule DAG, so they cannot wait on these rule outputs.
# ---------------------------------------------------------------------------

# GUNZIP_GTF: gunzip a .gz GTF, else copy. Exclusive with gffread_gtf.
[[rules]]
name = "gtf_gunzip"
description = "Canonicalize the GTF, gunzipping if .gz (nf-core GUNZIP_GTF)"
input = ["{config.gtf}"]
output = ["{config.out_dir}/reference/gtf.gtf"]
shell = """
set -euo pipefail
mkdir -p {config.out_dir}/reference
case "{config.gtf}" in
    *.gz) gzip -dc {input[0]} > {output[0]} ;;
    *)    cp {input[0]} {output[0]} ;;
esac
"""
when = "config.gff == \"\""
[rules.resources]
threads = 1
memory = "2G"
[rules.environment]
conda = "envs/python.yaml"

# GFFREAD: gff -> gtf when config.gff is set (upstream ext.args
# --keep-exon-attrs -F -T). Exclusive with gtf_gunzip.
[[rules]]
name = "gffread_gtf"
description = "Convert the GFF annotation to GTF with gffread (nf-core GFFREAD, --keep-exon-attrs -F -T)"
input = ["{config.gff}"]
output = ["{config.out_dir}/reference/gtf.gtf"]
shell = """
set -euo pipefail
mkdir -p {config.out_dir}/reference
case "{config.gff}" in
    *.gz) gzip -dc {input[0]} > gffread_in.gff ;;
    *)    cp {input[0]} gffread_in.gff ;;
esac
gffread --keep-exon-attrs -F -T -o {output[0]} gffread_in.gff
"""
when = "config.gff != \"\""
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/gffread.yaml"

# GUNZIP_FASTA: canonicalize the genome FASTA, gunzipping if .gz.
# Exclusive with fa_additional.
[[rules]]
name = "fa_gunzip"
description = "Canonicalize the genome FASTA, gunzipping if .gz (nf-core GUNZIP_FASTA)"
input = ["{config.fasta}"]
output = ["{config.out_dir}/reference/genome.fa"]
shell = """
set -euo pipefail
mkdir -p {config.out_dir}/reference
case "{config.fasta}" in
    *.gz) gzip -dc {input[0]} > {output[0]} ;;
    *)    cp {input[0]} {output[0]} ;;
esac
"""
when = "config.additional_fasta == \"\""
[rules.resources]
threads = 1
memory = "2G"
[rules.environment]
conda = "envs/python.yaml"

# CUSTOM_CATADDITIONALFASTA (fasta half): concatenate additional_fasta onto
# the genome. Exclusive with fa_gunzip; both write reference/genome.fa.
[[rules]]
name = "fa_additional"
description = "Concatenate additional_fasta onto the genome FASTA (nf-core CUSTOM_CATADDITIONALFASTA fasta emit)"
input = ["{config.fasta}", "{config.additional_fasta}"]
output = ["{config.out_dir}/reference/genome.fa"]
shell = """
set -euo pipefail
mkdir -p {config.out_dir}/reference
case "{config.fasta}" in
    *.gz) gzip -dc {input[0]} > genome_plain.fa ;;
    *)    cp {input[0]} genome_plain.fa ;;
esac
case "{config.additional_fasta}" in
    *.gz) gzip -dc {input[1]} >> genome_plain.fa ;;
    *)    cat {input[1]} >> genome_plain.fa ;;
esac
mv genome_plain.fa {output[0]}
"""
when = "config.additional_fasta != \"\""
[rules.resources]
threads = 1
memory = "2G"
[rules.environment]
conda = "envs/python.yaml"

# CUSTOM_GTFFILTER: keep lines whose seqname is in the genome FASTA (and
# that carry a transcript_id unless skip_gtf_transcript_filter). Upstream
# gate: filter needed when alignment or pseudo-alignment is enabled or no
# transcript_fasta is supplied, and skip_gtf_filter is false. The filter
# runs against the plain (pre-additional) genome like upstream.
[[rules]]
name = "gtf_filter"
description = "Filter the GTF to genome sequences with gtffilter.py (nf-core CUSTOM_GTFFILTER)"
input = [
    "{config.out_dir}/reference/gtf.gtf",
    "{config.fasta}",
]
output = ["{config.out_dir}/reference/gtf.filtered.gtf"]
shell = """
set -euo pipefail
mkdir -p {config.out_dir}/reference
case "{config.fasta}" in
    *.gz) gzip -dc {input[1]} > genome_plain.fa ;;
    *)    cp {input[1]} genome_plain.fa ;;
esac
if [ "{config.skip_gtf_transcript_filter}" = "true" ]; then
    SKIP_TRANSCRIPT_ID="--skip_transcript_id_check"
else
    SKIP_TRANSCRIPT_ID=""
fi
python scripts/gtffilter.py $SKIP_TRANSCRIPT_ID {input[0]} genome_plain.fa {output[0]}
"""
when = '!config.skip_gtf_filter && ((!config.skip_alignment && config.aligner != "") || (!config.skip_pseudo_alignment && config.pseudo_aligner != "") || config.transcript_fasta == "")'
[rules.resources]
threads = 1
memory = "4G"
[rules.environment]
conda = "envs/python.yaml"

# Filter bypass: copy when the upstream filter_gtf_needed gate is false.
# Exclusive with gtf_filter; both write reference/gtf.filtered.gtf.
[[rules]]
name = "gtf_filter_pass"
description = "Copy the GTF when CUSTOM_GTFFILTER is not needed (upstream filter_gtf_needed gate)"
input = ["{config.out_dir}/reference/gtf.gtf"]
output = ["{config.out_dir}/reference/gtf.filtered.gtf"]
shell = """
set -euo pipefail
mkdir -p {config.out_dir}/reference
cp {input[0]} {output[0]}
"""
when = 'config.skip_gtf_filter || ((config.skip_alignment || config.aligner == "") && (config.skip_pseudo_alignment || config.pseudo_aligner == "") && config.transcript_fasta != "")'
[rules.resources]
threads = 1
memory = "1G"
[rules.environment]
conda = "envs/python.yaml"

# CUSTOM_CATADDITIONALFASTA (gtf half): append transgene GTF lines generated
# from additional_fasta (fasta2gtf.py), biotype from featurecounts_group_type
# like upstream (gencode ? gene_type : featurecounts_group_type).
[[rules]]
name = "gtf_additional"
description = "Append transgene GTF lines from additional_fasta (nf-core CUSTOM_CATADDITIONALFASTA gtf emit)"
input = [
    "{config.out_dir}/reference/gtf.filtered.gtf",
    "{config.additional_fasta}",
]
output = ["{config.out_dir}/reference/gtf.processed.gtf"]
shell = """
set -euo pipefail
mkdir -p {config.out_dir}/reference
case "{config.additional_fasta}" in
    *.gz) gzip -dc {input[1]} > additional_plain.fa ;;
    *)    cp {input[1]} additional_plain.fa ;;
esac
if [ "{config.gencode}" = "true" ]; then
    BIOTYPE="gene_type"
else
    BIOTYPE="{config.featurecounts_group_type}"
fi
python scripts/fasta2gtf.py additional_plain.fa --biotype $BIOTYPE --out transgenes.gtf
cat {input[0]} transgenes.gtf > {output[0]}
"""
when = "config.additional_fasta != \"\""
[rules.resources]
threads = 1
memory = "2G"
[rules.environment]
conda = "envs/python.yaml"

# Pass-through when no additional_fasta is set. Exclusive with gtf_additional;
# both write reference/gtf.processed.gtf.
[[rules]]
name = "gtf_pass"
description = "Copy the filtered GTF when no additional_fasta is set"
input = ["{config.out_dir}/reference/gtf.filtered.gtf"]
output = ["{config.out_dir}/reference/gtf.processed.gtf"]
shell = """
set -euo pipefail
mkdir -p {config.out_dir}/reference
cp {input[0]} {output[0]}
"""
when = "config.additional_fasta == \"\""
[rules.resources]
threads = 1
memory = "1G"
[rules.environment]
conda = "envs/python.yaml"

# EAUTILS_GTF2BED (modules/nf-core/ea-utils/gtf2bed): perl gtf2bed.pl <gtf>
# <prefix> -> <prefix>.bed. Upstream runs it without ext.args (no -x), so the
# 12-column BED carries transcript ids; runs on any non-prokaryotic GTF
# (prokaryotic CDS-only annotations are excluded, see README).
[[rules]]
name = "gene_bed"
description = "Derive the 12-column gene BED from the GTF with ea-utils gtf2bed (nf-core EAUTILS_GTF2BED, or symlink a user-supplied gene_bed)"
input = ["{config.out_dir}/reference/gtf.processed.gtf"]
output = ["{config.out_dir}/reference/gene.bed"]
shell = """
set -euo pipefail
mkdir -p {config.out_dir}/reference
if [ -n "{config.gene_bed}" ]; then
    GENE_BED=$(cd "$(dirname {config.gene_bed})" && pwd)/$(basename {config.gene_bed})
    ln -s "$GENE_BED" {config.out_dir}/reference/gene.bed
    exit 0
fi
perl scripts/gtf2bed.pl {input[0]} {config.out_dir}/reference/gene
"""
when = "!config.skip_qc"
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/gtf2bed.yaml"

# SAMTOOLS_FAIDX (modules/nf-core/samtools/faidx): samtools faidx <fasta>
# then cut -f 1,2 <fasta>.fai > <fasta>.sizes (the .sizes emit). The fasta is
# staged into a scratch dir so the .fai sidecar never lands next to the
# source file.
[[rules]]
name = "chrom_sizes"
description = "Derive UCSC chrom.sizes from the genome FASTA with samtools faidx (nf-core SAMTOOLS_FAIDX, or symlink a user-supplied chrom_sizes)"
input = ["{config.out_dir}/reference/genome.fa"]
output = ["{config.out_dir}/reference/chrom_sizes.txt"]
shell = """
set -euo pipefail
mkdir -p {config.out_dir}/reference
if [ -n "{config.chrom_sizes}" ]; then
    CHROM_SIZES=$(cd "$(dirname {config.chrom_sizes})" && pwd)/$(basename {config.chrom_sizes})
    ln -s "$CHROM_SIZES" {config.out_dir}/reference/chrom_sizes.txt
    exit 0
fi
# {input[0]} renders as declared (relative fixture paths are relative
# to the workflow root) — absolutize like the symlink branches above, or
# the chrom_sizes_wd/genome.fa link resolves against its own directory
# and samtools faidx fails (live: Failed to open chrom_sizes_wd/genome.fa).
FASTA_ABS=$(cd "$(dirname {input[0]})" && pwd)/$(basename {input[0]})
mkdir chrom_sizes_wd
ln -s "$FASTA_ABS" chrom_sizes_wd/genome.fa
samtools faidx chrom_sizes_wd/genome.fa
cut -f 1,2 chrom_sizes_wd/genome.fa.fai > {config.out_dir}/reference/chrom_sizes.txt
"""
when = "!config.skip_bigwig"
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/samtools.yaml"

# RSEM_PREPAREREFERENCE (modules/nf-core/rsem/preparereference):
# rsem-prepare-reference --gtf <gtf> --num-threads <cpus> <fasta> rsem/genome
# then cp rsem/genome.transcripts.fa . (the transcript_fasta emit). Salmon
# alignment-mode quant, the pseudo-alignment indexes and the bowtie2_salmon
# transcriptome index all consume the transcript FASTA; the when below is the
# union of those consumer branches (star_rsem uses the RSEM index, whose
# transcriptome is built by the rsem_index rule instead).
[[rules]]
name = "transcript_fasta"
description = "Derive the transcript FASTA from the genome + GTF with RSEM (nf-core RSEM_PREPAREREFERENCE transcript_fasta emit, or symlink a user-supplied transcript_fasta)"
input = [
    "{config.out_dir}/reference/genome.fa",
    "{config.out_dir}/reference/gtf.processed.gtf",
]
output = ["{config.out_dir}/reference/transcripts.fa"]
shell = """
set -euo pipefail
mkdir -p {config.out_dir}/reference
if [ -n "{config.transcript_fasta}" ]; then
    case "{config.transcript_fasta}" in
        *.gz) CAT_CMD="zcat" ;;
        *)    CAT_CMD="cat" ;;
    esac
    if [ "{config.gencode}" = "true" ]; then
        # Upstream PREPROCESS_TRANSCRIPTS_FASTA_GENCODE: GENCODE headers
        # carry '|'-separated identifiers; keep only the first field.
        $CAT_CMD {config.transcript_fasta} | cut -d "|" -f1 > {config.out_dir}/reference/transcripts.fa
    else
        TRANSCRIPT_FASTA=$(cd "$(dirname {config.transcript_fasta})" && pwd)/$(basename {config.transcript_fasta})
        ln -s "$TRANSCRIPT_FASTA" {config.out_dir}/reference/transcripts.fa
    fi
    exit 0
fi
mkdir rsem_tf
rsem-prepare-reference --gtf {input[1]} --num-threads {effective_threads} {input[0]} rsem_tf/genome
cp rsem_tf/genome.transcripts.fa {config.out_dir}/reference/transcripts.fa
"""
when = "((config.aligner == 'star_salmon' || config.aligner == 'bowtie2_salmon') && !config.skip_alignment) || ((config.pseudo_aligner == 'salmon' || config.pseudo_aligner == 'kallisto') && !config.skip_pseudo_alignment)"
[rules.resources]
threads = 4
memory = "12G"
[rules.environment]
conda = "envs/rsem.yaml"
