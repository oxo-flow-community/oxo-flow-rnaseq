# Alignment fragment: nf-core/rnaseq ALIGN_STAR + ALIGN_HISAT2 +
# BAM_SORT_STATS_SAMTOOLS + BAM_DEDUP_UMI (genome side) +
# BAM_MARKDUPLICATES_PICARD (star_salmon / star_rsem / hisat2 paths).
#
# Rule -> upstream process (label: cpus/memory/time):
#   star_align (+bbsplit/sortmerna/bowtie2 read-source variants)
#                      STAR_ALIGN           (process_high: 12/72G/16h)
#   star_align_rsem (+3 variants) STAR_ALIGN (star_rsem quantifier args)
#   hisat2_splicesites HISAT2_EXTRACTSPLICESITES (process_medium: 2/12G/4h)
#   hisat2_index       HISAT2_BUILD        (process_high+high_memory: 12/200G)
#   hisat2_align (+3 read-source variants) HISAT2_ALIGN (process_high: 12/72G/16h)
#   samtools_sort / samtools_sort_hisat2 SAMTOOLS_SORT (process_medium: 6/36G/8h)
#   samtools_index_sorted  SAMTOOLS_INDEX       (process_low: 2/12G/4h)
#   samtools_stats_sorted  SAMTOOLS_STATS       (process_single: 1/6G/4h)
#   samtools_flagstat_sorted  SAMTOOLS_FLAGSTAT (process_single: 1/6G/4h)
#   samtools_idxstats_sorted  SAMTOOLS_IDXSTATS (process_single: 1/6G/4h)
#   picard_markduplicates  PICARD_MARKDUPLICATES (process_medium: 6/36G/8h)
#   samtools_index_markdup / stats / flagstat / idxstats (labels as above)
#   bam_dedup_genome_umitools(+primary/+stats variants) UMITOOLS_DEDUP (6/36G)
#   bam_dedup_genome_umicollapse    UMICOLLAPSE (process_high+high_memory: 12/200G)
#   samtools_view_primary / index_primary / index_dedup / stats / flagstat /
#   idxstats_dedup                  (labels as above)
#
# Upstream publish behaviour reproduced: the sorted/unsorted/intermediate BAMs
# are only published when save_align_intermeds (or skip_markduplicates); the
# port keeps them at results/star_salmon/ paths regardless so they act as
# checkpoints (see README fidelity table).

[workflow]
name = "alignment"
description = "STAR alignment, coordinate sort + index + stats, Picard mark duplicates and markdup-side BAM stats"

# STAR_ALIGN (star_salmon quantifier args). attrRG is only emitted when args
# do not contain --outSAMattrRGline, exactly like the upstream script:
#   STAR --genomeDir <index> --readFilesIn <R1> <R2> --runThreadN 12
#        --outFileNamePrefix <id>. --sjdbGTFfile <gtf>
#        --outSAMattrRGline 'ID:<id>' 'SM:<id>'
#        --quantMode TranscriptomeSAM --outSAMtype BAM Unsorted
#        --outSAMattributes NH HI AS NM MD --readFilesCommand zcat
#        --twopassMode Basic --runRNGseed 0 --outFilterMultimapNmax 20
#        --alignSJDBoverhangMin 1 --outSAMstrandField intronMotif
#        --quantTranscriptomeSAMoutput BanSingleEnd
[[rules]]
name = "star_align"
description = "STAR alignment with default star_salmon args (nf-core STAR_ALIGN)"
input = [
    "{config.out_dir}/trimgalore/{sample}_trimmed_1_val_1.fq.gz",
    "{config.out_dir}/trimgalore/{sample}_trimmed_2_val_2.fq.gz",
    "{config.star_index}",
    "{config.gtf}",
]
output = [
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.final.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.progress.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.SJ.out.tab",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.out.bam",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.toTranscriptome.out.bam",
]
shell = """
set -euo pipefail
STAR --genomeDir {input[2]} --readFilesIn {input[0]} {input[1]} --runThreadN {effective_threads} --outFileNamePrefix {sample}. --sjdbGTFfile {input[3]} --outSAMattrRGline 'ID:{sample}' 'SM:{sample}' --quantMode TranscriptomeSAM --outSAMtype BAM Unsorted --outSAMattributes NH HI AS NM MD --readFilesCommand zcat --twopassMode Basic --runRNGseed 0 --outFilterMultimapNmax 20 --alignSJDBoverhangMin 1 --outSAMstrandField intronMotif --quantTranscriptomeSAMoutput BanSingleEnd --limitBAMsortRAM $(( {effective_memory_mb} * 1000000 ))
mv {sample}.Log.final.out {sample}.Log.out {sample}.Log.progress.out {sample}.SJ.out.tab {config.out_dir}/{config.aligner}/log/
mv {sample}.Aligned.out.bam {sample}.Aligned.toTranscriptome.out.bam {config.out_dir}/{config.aligner}/
"""
when = "config.aligner == 'star_salmon' && !config.skip_alignment && config.skip_bbsplit && !config.remove_ribo_rna"
[rules.resources]
threads = 12
memory = "72G"
[rules.environment]
conda = "envs/star.yaml"

# STAR_ALIGN read-source variants (FASTQ_QC branches): identical command and
# outputs, reads come from the BBSplit / SortMeRNA / Bowtie2 rRNA-removal
# filtered-reads channels instead of the trimmed reads. Gates are mutually
# exclusive per config state (exactly one fires).
[[rules]]
name = "star_align_bbsplit"
description = "STAR alignment on BBSplit-filtered reads (nf-core STAR_ALIGN, star_salmon args)"
input = [
    "{config.out_dir}/bbsplit/{sample}_primary_1.fastq.gz",
    "{config.out_dir}/bbsplit/{sample}_primary_2.fastq.gz",
    "{config.star_index}",
    "{config.gtf}",
]
output = [
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.final.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.progress.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.SJ.out.tab",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.out.bam",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.toTranscriptome.out.bam",
]
shell = """
set -euo pipefail
STAR --genomeDir {input[2]} --readFilesIn {input[0]} {input[1]} --runThreadN {effective_threads} --outFileNamePrefix {sample}. --sjdbGTFfile {input[3]} --outSAMattrRGline 'ID:{sample}' 'SM:{sample}' --quantMode TranscriptomeSAM --outSAMtype BAM Unsorted --outSAMattributes NH HI AS NM MD --readFilesCommand zcat --twopassMode Basic --runRNGseed 0 --outFilterMultimapNmax 20 --alignSJDBoverhangMin 1 --outSAMstrandField intronMotif --quantTranscriptomeSAMoutput BanSingleEnd --limitBAMsortRAM $(( {effective_memory_mb} * 1000000 ))
mv {sample}.Log.final.out {sample}.Log.out {sample}.Log.progress.out {sample}.SJ.out.tab {config.out_dir}/{config.aligner}/log/
mv {sample}.Aligned.out.bam {sample}.Aligned.toTranscriptome.out.bam {config.out_dir}/{config.aligner}/
"""
when = "config.aligner == 'star_salmon' && !config.skip_alignment && !config.skip_bbsplit && !config.remove_ribo_rna"
[rules.resources]
threads = 12
memory = "72G"
[rules.environment]
conda = "envs/star.yaml"

[[rules]]
name = "star_align_sortmerna"
description = "STAR alignment on SortMeRNA non-rRNA reads (nf-core STAR_ALIGN, star_salmon args)"
input = [
    "{config.out_dir}/sortmerna/{sample}_1.non_rRNA.fastq.gz",
    "{config.out_dir}/sortmerna/{sample}_2.non_rRNA.fastq.gz",
    "{config.star_index}",
    "{config.gtf}",
]
output = [
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.final.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.progress.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.SJ.out.tab",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.out.bam",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.toTranscriptome.out.bam",
]
shell = """
set -euo pipefail
STAR --genomeDir {input[2]} --readFilesIn {input[0]} {input[1]} --runThreadN {effective_threads} --outFileNamePrefix {sample}. --sjdbGTFfile {input[3]} --outSAMattrRGline 'ID:{sample}' 'SM:{sample}' --quantMode TranscriptomeSAM --outSAMtype BAM Unsorted --outSAMattributes NH HI AS NM MD --readFilesCommand zcat --twopassMode Basic --runRNGseed 0 --outFilterMultimapNmax 20 --alignSJDBoverhangMin 1 --outSAMstrandField intronMotif --quantTranscriptomeSAMoutput BanSingleEnd --limitBAMsortRAM $(( {effective_memory_mb} * 1000000 ))
mv {sample}.Log.final.out {sample}.Log.out {sample}.Log.progress.out {sample}.SJ.out.tab {config.out_dir}/{config.aligner}/log/
mv {sample}.Aligned.out.bam {sample}.Aligned.toTranscriptome.out.bam {config.out_dir}/{config.aligner}/
"""
when = "config.aligner == 'star_salmon' && !config.skip_alignment && config.remove_ribo_rna && config.ribo_removal_tool == 'sortmerna'"
[rules.resources]
threads = 12
memory = "72G"
[rules.environment]
conda = "envs/star.yaml"

[[rules]]
name = "star_align_bowtie2"
description = "STAR alignment on Bowtie2-filtered reads (nf-core STAR_ALIGN, star_salmon args)"
input = [
    "{config.out_dir}/bowtie2_rrna/{sample}.bowtie2_filtered_1.fastq.gz",
    "{config.out_dir}/bowtie2_rrna/{sample}.bowtie2_filtered_2.fastq.gz",
    "{config.star_index}",
    "{config.gtf}",
]
output = [
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.final.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.progress.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.SJ.out.tab",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.out.bam",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.toTranscriptome.out.bam",
]
shell = """
set -euo pipefail
STAR --genomeDir {input[2]} --readFilesIn {input[0]} {input[1]} --runThreadN {effective_threads} --outFileNamePrefix {sample}. --sjdbGTFfile {input[3]} --outSAMattrRGline 'ID:{sample}' 'SM:{sample}' --quantMode TranscriptomeSAM --outSAMtype BAM Unsorted --outSAMattributes NH HI AS NM MD --readFilesCommand zcat --twopassMode Basic --runRNGseed 0 --outFilterMultimapNmax 20 --alignSJDBoverhangMin 1 --outSAMstrandField intronMotif --quantTranscriptomeSAMoutput BanSingleEnd --limitBAMsortRAM $(( {effective_memory_mb} * 1000000 ))
mv {sample}.Log.final.out {sample}.Log.out {sample}.Log.progress.out {sample}.SJ.out.tab {config.out_dir}/{config.aligner}/log/
mv {sample}.Aligned.out.bam {sample}.Aligned.toTranscriptome.out.bam {config.out_dir}/{config.aligner}/
"""
when = "config.aligner == 'star_salmon' && !config.skip_alignment && config.remove_ribo_rna && config.ribo_removal_tool == 'bowtie2'"
[rules.resources]
threads = 12
memory = "72G"
[rules.environment]
conda = "envs/star.yaml"

# STAR_ALIGN with the star_rsem quantifier args (upstream align_star.config
# 'rsem' branch: no --twopassMode / --runRNGseed / --outSAMstrandField /
# --quantTranscriptomeSAMoutput; adds the RSEM-oriented filtering flags).
# Same four FASTQ_QC read-source variants as the star_salmon rules.
[[rules]]
name = "star_align_rsem"
description = "STAR alignment with star_rsem args on trimmed reads (nf-core STAR_ALIGN)"
input = [
    "{config.out_dir}/trimgalore/{sample}_trimmed_1_val_1.fq.gz",
    "{config.out_dir}/trimgalore/{sample}_trimmed_2_val_2.fq.gz",
    "{config.star_index}",
    "{config.gtf}",
]
output = [
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.final.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.progress.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.SJ.out.tab",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.out.bam",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.toTranscriptome.out.bam",
]
shell = """
set -euo pipefail
STAR --genomeDir {input[2]} --readFilesIn {input[0]} {input[1]} --runThreadN {effective_threads} --outFileNamePrefix {sample}. --sjdbGTFfile {input[3]} --outSAMattrRGline 'ID:{sample}' 'SM:{sample}' --quantMode TranscriptomeSAM --outSAMtype BAM Unsorted --outSAMattributes NH HI AS NM MD --readFilesCommand zcat --outSAMunmapped Within --outFilterType BySJout --outFilterMultimapNmax 20 --outFilterMismatchNmax 999 --outFilterMismatchNoverLmax 0.04 --alignIntronMin 20 --alignIntronMax 1000000 --alignMatesGapMax 1000000 --alignSJoverhangMin 8 --alignSJDBoverhangMin 1 --sjdbScore 1 --limitBAMsortRAM $(( {effective_memory_mb} * 1000000 ))
mv {sample}.Log.final.out {sample}.Log.out {sample}.Log.progress.out {sample}.SJ.out.tab {config.out_dir}/{config.aligner}/log/
mv {sample}.Aligned.out.bam {sample}.Aligned.toTranscriptome.out.bam {config.out_dir}/{config.aligner}/
"""
when = "config.aligner == 'star_rsem' && !config.skip_alignment && config.skip_bbsplit && !config.remove_ribo_rna"
[rules.resources]
threads = 12
memory = "72G"
[rules.environment]
conda = "envs/star.yaml"

[[rules]]
name = "star_align_rsem_bbsplit"
description = "STAR alignment with star_rsem args on BBSplit-filtered reads (nf-core STAR_ALIGN)"
input = [
    "{config.out_dir}/bbsplit/{sample}_primary_1.fastq.gz",
    "{config.out_dir}/bbsplit/{sample}_primary_2.fastq.gz",
    "{config.star_index}",
    "{config.gtf}",
]
output = [
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.final.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.Log.progress.out",
    "{config.out_dir}/{config.aligner}/log/{sample}.SJ.out.tab",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.out.bam",
    "{config.out_dir}/{config.aligner}/{sample}.Aligned.toTranscriptome.out.bam",
]
shell = """
set -euo pipefail
STAR --genomeDir {input[2]} --readFilesIn {input[0]} {input[1]} --runThreadN {effective_threads} --outFileNamePrefix {sample}. --sjdbGTFfile {input[3]} --outSAMattrRGline 'ID:{sample}' 'SM:{sample}' --quantMode TranscriptomeSAM --outSAMtype BAM Unsorted --outSAMattributes NH HI AS NM MD --readFilesCommand zcat --outSAMunmapped Within --outFilterType BySJout --outFilterMultimapNmax 20 --outFilterMismatchNmax 999 --outFilterMismatchNoverLmax 0.04 --alignIntronMin 20 --alignIntronMax 1000000 --alignMatesGapMax 1000000 --alignSJoverhangMin 8 --alignSJDBoverhangMin 1 --sjdbScore 1 --limitBAMsortRAM $(( {effective_memory_mb} * 1000000 ))
mv {sample}.Log.final.out {sample}.Log.out {sample}.Log.progress.out {sample}.SJ.out.tab {config.out_dir}/{config.aligner}/log/
mv {sample}.Aligned.out.bam {sample}.Aligned.toTranscriptome.out.bam {config.out_dir}/{config.aligner}/
"""
when = "config.aligner == 'star_rsem' && !config.skip_alignment && !config.skip_bbsplit && !config.remove_ribo_rna"
[rules.resources]
threads = 12
memory = "72G"
[rules.environment]
conda = "envs/star.yaml"

[[rules]]
name = "star_align_rsem_sortmerna"
description = "STAR alignment with star_rsem args on SortMeRNA non-rRNA reads (nf-core STAR_ALIGN)"
input = [
    "{config.out_dir}/sortmerna/{sample}_1.non_rRNA.fastq.gz",
    "{config.out_dir}/sortmerna/{sample}_2.non_rRNA.fastq.gz",
    "{config.star_index}",
