# bigWig fragment: nf-core/rnaseq BEDGRAPH_BEDCLIP_BEDGRAPHTOBIGWIG
# (FW / REVERSE / COMBINED branches) — default path.
#
# Rule -> upstream process (label: cpus/memory/time):
#   genomecov_fw/rev/combined  BEDTOOLS_GENOMECOV_*  (process_single: 1/6G/4h)
#   bedclip_fw/rev/combined    UCSC_BEDCLIP          (process_medium: 6/36G/8h)
#   bigwig_fw/rev/combined     UCSC_BEDGRAPHTOBIGWIG (process_single: 1/6G/4h)
#
# Fidelity notes:
# - Upstream prefixes swap between forward/reverse libraries
#   (BEDTOOLS_GENOMECOV_FW emits <id>.reverse for reverse libraries). With
#   pipeline-level strandedness the published artifact set is identical, so
#   the port fixes the mapping: fw always emits <id>.forward (strand +),
#   rev always emits <id>.reverse (strand -). The FW/REV rules only run for
#   stranded libraries (upstream: combined runs for every sample, FW/REV only
#   when meta.strandedness != 'unstranded').
# - bedtools genomecov sort: --parallel=1 --buffer-size=3G (label 6G / 2).

[workflow]
name = "bigwig"
description = "bigWig coverage tracks: strand-specific and combined genome coverage, bedClip, bedGraphToBigWig"

[[rules]]
name = "genomecov_fw"
description = "Forward-strand genome coverage (nf-core BEDTOOLS_GENOMECOV_FW, -split -du -strand + -bg)"
input = ["{config.out_dir}/star_salmon/{sample}.markdup.sorted.bam"]
output = ["{config.out_dir}/star_salmon/{sample}.forward.bedGraph"]
shell = """
bedtools genomecov -ibam {input[0]} -split -du -strand + -bg | LC_ALL=C sort --parallel=1 --buffer-size=3G -k1,1 -k2,2n > {output[0]}
"""
when = '!config.skip_bigwig && (config.strandedness == "forward" || config.strandedness == "reverse")'
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/bedtools.yaml"

[[rules]]
name = "genomecov_rev"
description = "Reverse-strand genome coverage (nf-core BEDTOOLS_GENOMECOV_REV, -split -du -strand - -bg)"
input = ["{config.out_dir}/star_salmon/{sample}.markdup.sorted.bam"]
output = ["{config.out_dir}/star_salmon/{sample}.reverse.bedGraph"]
shell = """
bedtools genomecov -ibam {input[0]} -split -du -strand - -bg | LC_ALL=C sort --parallel=1 --buffer-size=3G -k1,1 -k2,2n > {output[0]}
"""
when = '!config.skip_bigwig && (config.strandedness == "forward" || config.strandedness == "reverse")'
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/bedtools.yaml"

[[rules]]
name = "genomecov_combined"
description = "Combined genome coverage (nf-core BEDTOOLS_GENOMECOV_COMBINED, -split -bg)"
input = ["{config.out_dir}/star_salmon/{sample}.markdup.sorted.bam"]
output = ["{config.out_dir}/star_salmon/{sample}.bedGraph"]
shell = """
bedtools genomecov -ibam {input[0]} -split -bg | LC_ALL=C sort --parallel=1 --buffer-size=3G -k1,1 -k2,2n > {output[0]}
"""
when = "!config.skip_bigwig"
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/bedtools.yaml"

# UCSC_BEDCLIP: bedClip <bedgraph> <chrom_sizes> <prefix>.bedGraph
[[rules]]
name = "bedclip_fw"
description = "Clip forward bedGraph to chrom sizes (nf-core UCSC_BEDCLIP, prefix <id>.clip.forward)"
input = ["{config.out_dir}/star_salmon/{sample}.forward.bedGraph", "{config.chrom_sizes}"]
output = ["{config.out_dir}/star_salmon/{sample}.clip.forward.bedGraph"]
shell = """
bedClip {input[0]} {input[1]} {output[0]}
"""
when = '!config.skip_bigwig && (config.strandedness == "forward" || config.strandedness == "reverse")'
[rules.resources]
threads = 6
memory = "36G"
[rules.environment]
conda = "envs/ucsc.yaml"

[[rules]]
name = "bedclip_rev"
description = "Clip reverse bedGraph to chrom sizes (nf-core UCSC_BEDCLIP, prefix <id>.clip.reverse)"
input = ["{config.out_dir}/star_salmon/{sample}.reverse.bedGraph", "{config.chrom_sizes}"]
output = ["{config.out_dir}/star_salmon/{sample}.clip.reverse.bedGraph"]
shell = """
bedClip {input[0]} {input[1]} {output[0]}
"""
when = '!config.skip_bigwig && (config.strandedness == "forward" || config.strandedness == "reverse")'
[rules.resources]
threads = 6
memory = "36G"
[rules.environment]
conda = "envs/ucsc.yaml"

[[rules]]
name = "bedclip_combined"
description = "Clip combined bedGraph to chrom sizes (nf-core UCSC_BEDCLIP, prefix <id>.clip)"
input = ["{config.out_dir}/star_salmon/{sample}.bedGraph", "{config.chrom_sizes}"]
output = ["{config.out_dir}/star_salmon/{sample}.clip.bedGraph"]
shell = """
bedClip {input[0]} {input[1]} {output[0]}
"""
when = "!config.skip_bigwig"
[rules.resources]
threads = 6
memory = "36G"
[rules.environment]
conda = "envs/ucsc.yaml"

# UCSC_BEDGRAPHTOBIGWIG: bedGraphToBigWig <bedgraph> <chrom_sizes> <prefix>.bigWig
[[rules]]
name = "bigwig_fw"
description = "Forward-strand bigWig (nf-core UCSC_BEDGRAPHTOBIGWIG, prefix <id>.forward)"
input = ["{config.out_dir}/star_salmon/{sample}.clip.forward.bedGraph", "{config.chrom_sizes}"]
output = ["{config.out_dir}/star_salmon/bigwig/{sample}.forward.bigWig"]
shell = """
bedGraphToBigWig {input[0]} {input[1]} {output[0]}
"""
when = '!config.skip_bigwig && (config.strandedness == "forward" || config.strandedness == "reverse")'
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/ucsc.yaml"

[[rules]]
name = "bigwig_rev"
description = "Reverse-strand bigWig (nf-core UCSC_BEDGRAPHTOBIGWIG, prefix <id>.reverse)"
input = ["{config.out_dir}/star_salmon/{sample}.clip.reverse.bedGraph", "{config.chrom_sizes}"]
output = ["{config.out_dir}/star_salmon/bigwig/{sample}.reverse.bigWig"]
shell = """
bedGraphToBigWig {input[0]} {input[1]} {output[0]}
"""
when = '!config.skip_bigwig && (config.strandedness == "forward" || config.strandedness == "reverse")'
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/ucsc.yaml"

[[rules]]
name = "bigwig_combined"
description = "Combined bigWig (nf-core UCSC_BEDGRAPHTOBIGWIG, prefix <id>)"
input = ["{config.out_dir}/star_salmon/{sample}.clip.bedGraph", "{config.chrom_sizes}"]
output = ["{config.out_dir}/star_salmon/bigwig/{sample}.bigWig"]
shell = """
bedGraphToBigWig {input[0]} {input[1]} {output[0]}
"""
when = "!config.skip_bigwig"
[rules.resources]
threads = 1
memory = "6G"
[rules.environment]
conda = "envs/ucsc.yaml"
